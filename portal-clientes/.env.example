# Use la misma DATABASE_URL del programa de remisiones.
DATABASE_URL=
PORTAL_PORT=3018
PORTAL_ADMIN_PASSWORD=
PORTAL_SESSION_SECRET=
NODE_ENV=development
# Al publicarlo, configure la dirección pública del portal para que el
# mensaje de WhatsApp incluya un enlace directo al pedido del administrador.
PORTAL_PUBLIC_URL=
# Para notificaciones automáticas a +57 300 254 3548 por Meta Cloud API.
# Use un número remitente habilitado en WhatsApp Business Platform.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_CO
