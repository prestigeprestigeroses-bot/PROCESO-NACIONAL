# Use la misma DATABASE_URL del programa de remisiones.
DATABASE_URL=
PORTAL_PORT=3018
PORTAL_ADMIN_PASSWORD=
PORTAL_SESSION_SECRET=
NODE_ENV=development
# Al publicarlo, configure la dirección pública del portal para que el
# mensaje de WhatsApp incluya un enlace directo al pedido del administrador.
PORTAL_PUBLIC_URL=
# Para notificaciones automáticas a +57 300 254 3548 por Meta Cloud API.
# Use un número remitente habilitado en WhatsApp Business Platform.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=573002543548
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_CO
# Para aprobar con el botón del WhatsApp del administrador y confirmar al cliente.
# Deben ser dos plantillas de utilidad aprobadas en Meta, con el mismo idioma anterior.
WHATSAPP_APPROVAL_TEMPLATE_NAME=
# Opcional: plantilla nueva con dos respuestas rápidas, Aprobar pedido y Rechazar pedido.
WHATSAPP_DECISION_TEMPLATE_NAME=
WHATSAPP_CUSTOMER_TEMPLATE_NAME=
# El token de verificación lo inventa usted; debe coincidir con el de Meta Webhooks.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Se obtiene en Meta Developers > Configuración de la app > Básica.
WHATSAPP_APP_SECRET=
